# =============================================================================
# INVENTARIO DEDALO - FRONTEND (React + TypeScript + Vite)
# F000.1 - Plantilla de variables de entorno
# -----------------------------------------------------------------------------
# Copia este archivo a `.env.local` y completa los valores reales:
#   PowerShell :  Copy-Item .env.example .env.local
#   Bash       :  cp .env.example .env.local
#
# REGLAS:
#   - NUNCA subir `.env.local` al repositorio (esta en .gitignore).
#   - Solo las variables con prefijo VITE_ quedan expuestas al navegador.
#   - NUNCA poner la service_role key de Supabase aqui: solo la anon key.
# =============================================================================

# --------------------------------- APP ---------------------------------------
VITE_APP_NAME=Inventario Dedalo
VITE_APP_ENV=
VITE_APP_VERSION=0.1.0

# --------------------------------- API ---------------------------------------
VITE_API_URL=
VITE_API_PREFIX=/api/v1

# --------------------------- LOCALE / FORMATO --------------------------------
VITE_LOCALE=es-PE
VITE_CURRENCY=PEN
VITE_TIMEZONE=America/Lima

# ------------------------------- SUPABASE ------------------------------------
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ----------------------------- FEATURE FLAGS ---------------------------------
VITE_FEATURE_PWA=
VITE_FEATURE_OFFLINE=
VITE_FEATURE_CAMERA=
